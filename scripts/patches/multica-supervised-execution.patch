diff --git a/server/pkg/agent/gwi_supervised_execution_test.go b/server/pkg/agent/gwi_supervised_execution_test.go
new file mode 100644
--- /dev/null
+++ b/server/pkg/agent/gwi_supervised_execution_test.go
@@ -0,0 +1,40 @@
+package agent
+
+import (
+	"runtime"
+	"testing"
+	"time"
+)
+
+func TestGWISupervisedExecutionKeepsSilentModelWork(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("the synthetic RPC process uses a POSIX shell")
+	}
+	for _, supervised := range []bool{false, true} {
+		name := "upstream-watchdogs"
+		if supervised {
+			name = "owner-supervision"
+		}
+		t.Run(name, func(t *testing.T) {
+			fake := writeFakeCodexAppServer(t, ""+
+				"read line\n"+
+				"echo '{\"id\":1,\"result\":{}}'\n"+
+				"read line\nread line\n"+
+				"echo '{\"id\":2,\"result\":{\"thread\":{\"id\":\"synthetic-thread\"}}}'\n"+
+				"read line\n"+
+				"echo '{\"id\":3,\"result\":{}}'\n"+
+				"echo '{\"method\":\"turn/started\",\"params\":{\"threadId\":\"synthetic-thread\",\"turn\":{\"id\":\"synthetic-turn\"}}}'\n"+
+				"sleep 0.12\n"+
+				"echo '{\"method\":\"item/completed\",\"params\":{\"threadId\":\"synthetic-thread\",\"item\":{\"type\":\"agentMessage\",\"id\":\"synthetic-result\",\"text\":\"Verified synthetic result\"}}}'\n"+
+				"echo '{\"method\":\"turn/completed\",\"params\":{\"threadId\":\"synthetic-thread\",\"turn\":{\"id\":\"synthetic-turn\",\"status\":\"completed\"}}}'\n")
+			result := executeFakeCodex(t, fake, ExecOptions{SupervisedExecution: supervised, SemanticInactivityTimeout: 40 * time.Millisecond, FirstTurnNoProgressTimeout: 30 * time.Millisecond})
+			if supervised {
+				if result.Status != "completed" || result.Output != "Verified synthetic result" {
+					t.Fatalf("supervised execution was cut short: %#v", result)
+				}
+			} else if result.Status != "timeout" {
+				t.Fatalf("the opt-in patch changed upstream default behavior: %#v", result)
+			}
+		})
+	}
+}
